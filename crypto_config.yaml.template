# ─────────────────────────────────────────────────────────────
# crypto_config.yaml — 加密資產快照所需的交易所 API 金鑰
#
# 使用方式：
#   1. cp crypto_config.yaml.template crypto_config.yaml
#   2. 填入下方 binance 的 api_key / api_secret（建議開「只讀 Read-Only」權限即可）
#   3. 執行 python data/fetch_crypto_balance.py
#
# 注意：crypto_config.yaml 已在 .gitignore 中排除，永遠不要 commit。
#
# 派網（Pionex）為何不在這裡？
#   派網公開 API 的 /account/balances 只回傳現貨錢包，
#   不含 網格 / DCA / Earn 鎖倉；所以派網總資產改由前端
#   「派網總資產（TWD）」輸入框手動維護，不需要在這裡設定金鑰。
# ─────────────────────────────────────────────────────────────

binance:
  # Binance 現貨 / 合約共用金鑰（建議只勾 Enable Reading）
  api_key: ""
  api_secret: ""
  # 若需代理（例如 Surfshark Dedicated IP）才能存取 Binance，填入完整 URL
  # 例：http://username:password@host:port
  proxy: ""
  # 個別關閉某邊可設為 false（預設兩邊都抓）
  fetch_spot: true
  fetch_futures: true
